# Frontend Environment Variables

# API Base URL - Ya incluye /api/v1
VITE_API_URL=http://api.fresaterra.shop:8000/api/v1

# Frontend URL - Para callbacks de autenticación social
VITE_FRONTEND_URL=http://localhost:5173

# Mercado Pago Configuration
VITE_MP_PUBLIC_KEY=your_mercadopago_public_key_here

# App Configuration
VITE_APP_NAME=Fresaterra
VITE_APP_VERSION=1.0.0

# Environment
VITE_NODE_ENV=development

# Debug mode
VITE_DEBUG=true
